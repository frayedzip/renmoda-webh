# ---- Server ----------------------------------------------------------------

# Port the Express app listens on (Caddy/nginx proxies to this).
PORT=3000

# Path to the SQLite file (processed webhook event IDs + credit audit log).
# The directory is created if missing. Back this file up — it's the dedupe
# memory that prevents double-crediting on webhook redelivery.
DB_PATH=./data/membership.db

# ---- Razorpay --------------------------------------------------------------

# API key pair from Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Secret you chose when registering the webhook endpoint in
# Dashboard -> Account & Settings -> Webhooks. This is NOT key_secret —
# mixing them up makes every signature check fail.
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# The monthly membership Plan (Dashboard -> Subscriptions -> Plans).
# Its amount is the monthly fee members pay.
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx

# Number of billing cycles per subscription. Razorpay requires a finite
# number; 120 monthly cycles = 10 years = effectively "until cancelled".
RAZORPAY_TOTAL_COUNT=120

# ---- Shopify ---------------------------------------------------------------

# The store's CANONICAL .myshopify.com domain (not the custom storefront domain,
# and not necessarily the readable brand handle). Newer stores have a
# system-generated hash domain like abc123-4.myshopify.com. If OAuth fails with
# "unexpected shop", use the domain Shopify names in that error.
SHOPIFY_SHOP=renmoda.myshopify.com

# --- Shopify auth: pick ONE of the two options below ---
#
# The app's scopes must include (configured in the Dev Dashboard app, or on the
# in-admin custom app): read_customers, write_customers,
# read_store_credit_accounts, read_store_credit_account_transactions,
# write_store_credit_account_transactions.
#
# OPTION A (legacy) — static Admin API token from an in-admin custom app
# (Settings -> Apps -> Develop apps). Starts with shpat_. Shopify no longer
# lets most stores create these. If you have one, set it and leave A's client
# vars blank; it takes precedence.
SHOPIFY_ADMIN_TOKEN=

# OPTION B (current) — Dev Dashboard app credentials. From these the service
# obtains an Admin token one of two ways, decided by your store type:
#
#   * DEVELOPMENT store  -> client credentials grant (24h token, auto-refreshed).
#     Works only if the app + store are in the same org.
#
#   * PRODUCTION / paid store  -> client credentials is NOT permitted
#     (shop_not_permitted). Instead run the one-time OAuth install: open
#     /oauth/install as the store owner; the service exchanges the code for a
#     permanent OFFLINE token and stores it in the SQLite DB. Nothing more to
#     put here after that — the offline token takes over automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# OAuth callback URL for the /oauth/install flow above. Optional: if unset it's
# derived from the request (fine for local: http://localhost:3000/oauth/callback).
# Behind a proxy, set the public HTTPS URL explicitly. Whatever you use here MUST
# be added to the app's "Allowed redirection URL(s)" in the Dev Dashboard.
# SHOPIFY_REDIRECT_URI=https://membership.renmoda.in/oauth/callback

# Admin GraphQL API version. Bump deliberately, not automatically.
SHOPIFY_API_VERSION=2025-01

# ---- Membership policy -----------------------------------------------------

# Store credit granted per successful monthly charge, in whole currency units.
# Rs 4000 at Rs 1000/item = 4 rentals/month. The balance IS the quota.
MEMBERSHIP_ALLOWANCE=4000

# Currency for store credit. Must match the store's currency for credit to be
# spendable at checkout.
MEMBERSHIP_CURRENCY=INR

# When a membership ends (halted/cancelled/completed): also wipe remaining
# store credit? Business policy the client hasn't finalized — flip without a
# code change. true = wipe, false = leave leftover credit spendable.
REVOKE_CREDIT_ON_END=true

# Customer tag that gates member-only access on the storefront.
ACTIVE_MEMBER_TAG=active_member

# ---- Join flow -------------------------------------------------------------

# Where members land after a successful subscription authorization
# (storefront "welcome" page).
JOIN_SUCCESS_URL=https://renmoda.in/pages/welcome

# Where GET /join/redirect sends the browser if subscription creation fails
# (storefront "something went wrong" page).
JOIN_FAILURE_URL=https://renmoda.in/pages/join-error
